{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",          // 👈 ES6 modules
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}